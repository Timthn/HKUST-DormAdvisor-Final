# Root .gitignore

# Secrets & env — ignore all variants; keep *example templates (e.g. .env.example, .env.local.example)
.env
.env.*
!.env*.example

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.turbo
frontend/.eslintcache
frontend/*.tsbuildinfo
frontend/coverage/
frontend/.nyc_output/

# Backend
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/**/*.py[cod]
backend/venv/
backend/.venv/
backend/env/
backend/.venv_test/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/htmlcov/
backend/.coverage
backend/*.egg-info/
backend/dist/
backend/build/
# IDE
.cursor/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
.vercel
.railway
*.pem
*.key

# Optional: OS junk in nested dirs
**/Thumbs.db

# Scripts & Tools (not part of main app)
Crawler_Cloud.py
/scripts/
/tools/

# Alibaba Cloud Bailian (Model Studio)
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_APP_ID_CHAT=your_chat_agent_app_id_here
BAILIAN_APP_ID_RECOMMEND=your_recommend_agent_app_id_here

# DeepSeek API (for Extractor module)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Development Mode
DEV_MODE=true

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# JWT Secret (must match Supabase when frontend uses Supabase Auth)
# Get from: Supabase Dashboard → Project Settings → API → JWT Secret
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256

# CORS
FRONTEND_URL=http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
